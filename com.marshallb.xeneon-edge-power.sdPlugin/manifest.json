{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "XENEON EDGE Power",
    "Version": "1.0.0.0",
    "Author": "MarshallB",
    "Actions": [
        {
            "Name": "Power Toggle",
            "UUID": "com.marshallb.xeneon-edge-power.power-toggle",
            "Icon": "imgs/actions/power/icon",
            "Tooltip": "Turn your XENEON EDGE monitor on or off.",
            "Controllers": [
                "Keypad"
            ],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Name": "On",
                    "Image": "imgs/actions/power/key-on",
                    "TitleAlignment": "middle"
                },
                {
                    "Name": "Off",
                    "Image": "imgs/actions/power/key-off",
                    "TitleAlignment": "middle"
                }
            ]
        }
    ],
    "Category": "XENEON EDGE Power",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "Description": "Control the power state of your XENEON EDGE monitor directly from Stream Deck using DDC/CI.",
    "Icon": "imgs/plugin/marketplace",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "UUID": "com.marshallb.xeneon-edge-power"
}